# --- Database ---------------------------------------------------------------
# Production: Neon Postgres (EU region), pooled connection string.
# Leave empty for local use: an embedded Postgres (PGlite) is stored in ./data/db
DATABASE_URL=

# --- Secrets (REQUIRED in production; auto-generated into ./data/secrets.json locally) ---
# 64+ random hex chars each, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# --- Daily report (optional) ------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Protects /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

TZ=Africa/Tunis
